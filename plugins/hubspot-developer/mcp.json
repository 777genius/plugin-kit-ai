{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hubspot-developer": {
      "type": "stdio",
      "args": [
        "-y",
        "-p",
        "@hubspot/cli@8.12.0",
        "hs",
        "mcp",
        "start"
      ],
      "command": "npx",
      "env": {
        "HUBSPOT_CLI_VERSION": "8.12.0",
        "HUBSPOT_MCP_STANDALONE": "true"
      }
    }
  }
}
