[Unit]
Description=UAP reviewed stable-launch runner
Requires=uap-observer-runner.socket
After=local-fs.target

[Service]
Type=simple
ExecStartPre=/usr/bin/test -f /opt/uap-observer-current/.complete
User=root
Group=root
ExecStart=/opt/uap-observer-current/venv/bin/python /opt/uap-observer-current/libexec/uap-observer-runner --socket-fd 3
Environment=UAP_OBSERVER_ISOLATION=systemd-positive-mount-allowlist-v1
WorkingDirectory=/
KillMode=control-group
Delegate=pids
TimeoutStopSec=10s
Restart=on-failure
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=no
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_CHOWN CAP_SETGID CAP_SETUID
AmbientCapabilities=
SystemCallFilter=@system-service @chown setgid setgroups setuid
SystemCallErrorNumber=EPERM
RestrictRealtime=yes
RemoveIPC=yes
TasksMax=64
MemoryMax=2G
CPUQuota=200%
TemporaryFileSystem=/:ro,nosuid,nodev,noexec
BindReadOnlyPaths=/usr/bin /usr/lib -/usr/lib64 -/lib -/lib64 /etc/passwd /etc/group /etc/nsswitch.conf -/etc/ssl -/etc/pki
BindPaths=/var/lib/uap-observer/jobs /var/lib/uap-observer/workspaces /var/lib/uap-observer/profiles /var/lib/uap-observer-human/pending /var/lib/uap-observer-human/reserved /var/lib/uap-observer-human/consumed /var/lib/uap-observer-consent/pending /var/lib/uap-observer-consent/reserved /var/lib/uap-observer-consent/consumed
BindReadOnlyPaths=/opt/uap-observer-current
BindReadOnlyPaths=/opt/uap-observer-current/etc/hosts:/etc/hosts
ReadWritePaths=/var/lib/uap-observer/jobs /var/lib/uap-observer/workspaces /var/lib/uap-observer/profiles /var/lib/uap-observer-human/pending /var/lib/uap-observer-human/reserved /var/lib/uap-observer-human/consumed /var/lib/uap-observer-consent/pending /var/lib/uap-observer-consent/reserved /var/lib/uap-observer-consent/consumed
UMask=0077
