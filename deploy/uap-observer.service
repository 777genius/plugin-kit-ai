[Unit]
Description=UAP protected stable-launch observer
After=network-online.target uap-observer-egress-proxy.socket uap-observer-signer.service uap-observer-runner.socket
Requires=uap-observer-egress-proxy.socket uap-observer-signer.service uap-observer-runner.socket

[Service]
Type=simple
ExecStartPre=/usr/bin/test -f /opt/uap-observer-current/.complete
User=uap-observer
Group=uap-observer
SupplementaryGroups=uap-observer-signer-ipc uap-observer-runner-ipc
ExecStart=/opt/uap-observer-current/venv/bin/python -m observer.http_server --config /opt/uap-observer-current/etc/uap-observer.json
WorkingDirectory=/opt/uap-observer-current/runtime
Environment=PYTHONPATH=/opt/uap-observer-current/runtime
Environment=HTTPS_PROXY=http://127.0.0.2:8766
Environment=https_proxy=http://127.0.0.2:8766
Environment=HTTP_PROXY=http://127.0.0.2:8766
Environment=http_proxy=http://127.0.0.2:8766
Environment=NO_PROXY=
Environment=no_proxy=
Restart=on-failure
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/var/run/docker.sock -/run/docker.sock
ReadWritePaths=/var/lib/uap-observer/state
ReadOnlyPaths=/opt/uap-observer-current
UMask=0077

[Install]
WantedBy=multi-user.target
