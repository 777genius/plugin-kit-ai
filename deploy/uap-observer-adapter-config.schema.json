{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "request_policy", "git", "clients", "matrix", "consent_record", "chatgpt", "workspace_root", "external_pr_evidence", "egress_hosts"],
  "properties": {
    "schema_version": {"const": 1},
    "egress_hosts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"}
    },
    "request_policy": {
      "type": "object",
      "required": ["catalog_repository", "cli_release_repository", "cli_release_tag", "release_manifest_digest", "release_checksums_digest", "directory_digest", "scenario_contract_digest"],
      "properties": {
        "catalog_repository": {"const": "777genius/universal-agent-plugins"},
        "cli_release_repository": {"const": "777genius/plugin-kit-ai"},
        "cli_release_tag": {"const": "agentplugins-v0.1.14"},
        "release_manifest_digest": {"const": "sha256:21b72bb9fc82df2b45ce2e83ea79eeb5b8436cfd9b09f8ccfcbb25c8d0fda8f9"},
        "release_checksums_digest": {"const": "sha256:bd9f8de83b9b04589d2b29ce36ae079bf5f67b10b8f44c5ab811fc5d6706ff6b"},
        "directory_digest": {"$ref": "#/$defs/digest"},
        "scenario_contract_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "workspace_root": {"const": "/var/lib/uap-observer/workspaces"},
    "git": {"type":"object","required":["binary","sha256"],"properties":{"binary":{"const":"/opt/uap-observer-inputs/bin/git"},"sha256":{"$ref":"#/$defs/digest"}},"additionalProperties":false},
    "external_pr_evidence": {"type":"object","required":["path","sha256"],"properties":{"path":{"const":"/opt/uap-observer-inputs/external-pr-evidence.json"},"sha256":{"$ref":"#/$defs/digest"}},"additionalProperties":false},
    "clients": {
      "type": "object",
      "required": ["codex", "cursor", "kiro"],
      "properties": {
        "codex": {"$ref": "#/$defs/client"},
        "cursor": {"$ref": "#/$defs/client"},
        "kiro": {"$ref": "#/$defs/client"}
      },
      "additionalProperties": false
    },
    "matrix": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/matrix"}},
    "consent_record": {
      "type": "object",
      "required": ["directory"],
      "properties": {"directory": {"const": "/var/lib/uap-observer-consent/pending"}},
      "additionalProperties": false
    },
    "chatgpt": {
      "type": "object",
      "required": ["app_binding_path", "app_binding_sha256", "app_id", "mcp_endpoint", "human_attestation_directory", "tuple", "client_version", "projection_receipt_path", "projection_receipt_sha256"],
      "properties": {
        "app_binding_path": {"const": "/opt/uap-observer-inputs/chatgpt/app-binding.json"},
        "app_binding_sha256": {"$ref": "#/$defs/digest"},
        "app_id": {"type": "string", "pattern": "^plugin_asdk_app_[a-f0-9]{32}$"},
        "mcp_endpoint": {"const": "https://docs.mcp.cloudflare.com/mcp"},
        "human_attestation_directory": {"const": "/var/lib/uap-observer-human/pending"},
        "tuple": {"$ref": "#/$defs/tuple"}, "client_version": {"type": "string", "minLength": 1},
        "projection_receipt_path": {"const": "/opt/uap-observer-inputs/chatgpt/projection-receipt.json"},
        "projection_receipt_sha256": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "tuple": {
      "type": "object",
      "required": ["product_id", "tree_digest", "manifest_digest", "distribution_id", "distribution_kind", "release_sequence", "package_version", "source_repository", "source_revision", "source_path", "snapshot_sequence", "snapshot_digest", "binary_digest", "dependency_identity", "installer_version", "adapter_version", "client_version", "os", "architecture", "observed_at"],
      "properties": {
        "product_id": {"type": "string", "minLength": 1},
        "tree_digest": {"$ref": "#/$defs/digest"}, "manifest_digest": {"$ref": "#/$defs/digest"},
        "distribution_id": {"type": "string", "minLength": 1}, "distribution_kind": {"type": "string", "minLength": 1},
        "release_sequence": {"type": "integer", "minimum": 1}, "package_version": {"type": "string", "minLength": 1},
        "source_repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_path": {"type": "string", "minLength": 1},
        "snapshot_sequence": {"type": "integer", "minimum": 1}, "snapshot_digest": {"$ref": "#/$defs/digest"},
        "binary_digest": {"$ref": "#/$defs/digest"}, "dependency_identity": {"type": "string", "minLength": 1},
        "installer_version": {"type": "string", "minLength": 1}, "adapter_version": {"type": "string", "minLength": 1},
        "client_version": {"type": "null"}, "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/digest"}},
      "additionalProperties": false
    },
    "binary": {
      "type": "object", "required": ["binary", "sha256"],
      "properties": {"binary": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/digest"}},
      "additionalProperties": false
    },
    "client": {
      "type": "object", "required": ["binary", "sha256", "profile", "client_id", "native_projection"],
      "properties": {
        "binary": {"enum": ["/opt/uap-observer-inputs/bin/codex", "/opt/uap-observer-inputs/bin/cursor", "/opt/uap-observer-inputs/bin/kiro"]}, "sha256": {"$ref": "#/$defs/digest"},
        "profile": {"type": "string", "pattern": "^/var/lib/uap-observer/profiles/"},
        "client_id": {"enum": ["codex", "cursor", "kiro"]},
        "companion_binary": {"const": "/opt/uap-observer-inputs/bin/kiro-cli-chat"},
        "companion_sha256": {"$ref": "#/$defs/digest"},
        "native_projection": {
          "type": "object", "required": ["path", "sha256"],
          "properties": {"path": {"type": "string", "pattern": "^/var/lib/uap-observer/proofs/(?:codex|cursor|kiro)/native-projection\\.json$"}, "sha256": {"$ref": "#/$defs/digest"}},
          "additionalProperties": false
        }
      },
      "allOf": [
        {"if": {"properties": {"client_id": {"const": "codex"}}}, "then": {"not": {"anyOf": [{"required": ["companion_binary"]}, {"required": ["companion_sha256"]}]}, "properties": {"binary": {"const": "/opt/uap-observer-inputs/bin/codex"}, "profile": {"const": "/var/lib/uap-observer/profiles/codex"}, "native_projection": {"properties": {"path": {"const": "/var/lib/uap-observer/proofs/codex/native-projection.json"}}}}}},
        {"if": {"properties": {"client_id": {"const": "cursor"}}}, "then": {"not": {"anyOf": [{"required": ["companion_binary"]}, {"required": ["companion_sha256"]}]}, "properties": {"binary": {"const": "/opt/uap-observer-inputs/bin/cursor"}, "profile": {"const": "/var/lib/uap-observer/profiles/cursor"}, "native_projection": {"properties": {"path": {"const": "/var/lib/uap-observer/proofs/cursor/native-projection.json"}}}}}},
        {"if": {"properties": {"client_id": {"const": "kiro"}}}, "then": {"required": ["companion_binary", "companion_sha256"], "properties": {"binary": {"const": "/opt/uap-observer-inputs/bin/kiro"}, "sha256": {"const": "sha256:adab7305f27302bb4da93590ecb6d6ac49b9cad6d7f4cd17010735358cf32336"}, "companion_sha256": {"const": "sha256:c8c4edf122e66b07cc96729823ffa04d6f9a4dfd887590d36b76f809fce039c4"}, "profile": {"const": "/var/lib/uap-observer/profiles/kiro"}, "native_projection": {"properties": {"path": {"const": "/var/lib/uap-observer/proofs/kiro/native-projection.json"}}}}}}
      ],
      "additionalProperties": false
    },
    "matrix": {
      "type": "object", "required": ["plugin", "client", "tuple", "application_id", "endpoint"],
      "properties": {
        "plugin": {"enum": ["agent-code-navigator", "context7", "cloudflare-docs", "chrome-devtools", "notion"]},
        "client": {"enum": ["codex", "cursor", "kiro"]}, "tuple": {"$ref": "#/$defs/tuple"},
        "application_id": {"type": "string", "minLength": 1}, "endpoint": {"type": "string", "pattern": "^https://"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
