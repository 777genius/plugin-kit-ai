{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Redacted stable-launch E2E evidence",
  "type": "object",
  "required": ["schema_version", "run", "release", "directory", "scenario_contract", "matrix", "summary", "privacy"],
  "properties": {
    "schema_version": {"const": 3},
    "run": {
      "type": "object",
      "required": ["id", "mode", "runtime_claims", "observed_at", "platform", "architecture", "disposable", "root_id", "github_sha", "github_run_id", "github_run_attempt", "caller_event_name", "caller_ref", "caller_workflow_ref", "challenge", "observer_bundle_digest", "cli"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
        "mode": {"enum": ["enforced", "fixture-only"]},
        "runtime_claims": {"type": "boolean"},
        "observed_at": {"type": "string", "format": "date-time"},
        "platform": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "disposable": {"const": true},
        "root_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
        "github_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
        "github_run_id": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
        "github_run_attempt": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
        "caller_event_name": {"type": ["string", "null"], "enum": ["push", "schedule", "workflow_dispatch", null]},
        "caller_ref": {"type": ["string", "null"], "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"},
        "caller_workflow_ref": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/directory-publication\\.yml@refs/heads/main$"},
        "challenge": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "observer_bundle_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "cli": {
          "type": "object",
          "required": ["available", "version", "binary_digest"],
          "properties": {
            "available": {"type": "boolean"},
            "version": {"type": ["string", "null"]},
            "binary_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "enforced"}}}, "then": {"properties": {"runtime_claims": {"const": true}, "github_sha": {"type": "string"}, "github_run_id": {"type": "string"}, "github_run_attempt": {"type": "string"}, "caller_event_name": {"type": "string"}, "caller_ref": {"const": "refs/heads/main"}, "caller_workflow_ref": {"type": "string"}, "challenge": {"type": "string"}, "observer_bundle_digest": {"type": "string"}, "cli": {"properties": {"available": {"const": true}, "version": {"type": "string", "pattern": "^(?:0\\.1\\.(?:[89]|[1-9][0-9]+)|0\\.(?:[2-9]|[1-9][0-9]+)\\.[0-9]+|[1-9][0-9]*\\.[0-9]+\\.[0-9]+)$"}, "binary_digest": {"type": "string"}}}}}},
        {"if": {"properties": {"mode": {"const": "fixture-only"}}}, "then": {"properties": {"runtime_claims": {"const": false}}}}
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object", "required": ["repository", "tag", "tag_commit", "release_id", "immutable", "manifest_digest", "checksums_digest"],
      "properties": {
        "repository": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "tag": {"type": ["string", "null"], "pattern": "^agentplugins-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "tag_commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
        "release_id": {"type": ["integer", "null"], "minimum": 1},
        "immutable": {"type": ["boolean", "null"]},
        "manifest_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "checksums_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
      }, "additionalProperties": false
    },
    "directory": {
      "type": "object", "required": ["origin", "snapshot_digest", "sequence", "trust_root_digest"],
      "properties": {
        "origin": {"type": ["string", "null"], "pattern": "^https://"},
        "snapshot_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "sequence": {"type": ["integer", "null"], "minimum": 1},
        "trust_root_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
      }, "additionalProperties": false
    },
    "scenario_contract": {
      "type": "object", "required": ["id", "digest", "expected_ids", "required_singleton_ids", "expected_counts"],
      "properties": {
        "id": {"const": "acceptance-26.1-stable-release-v2"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "expected_ids": {"type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true, "items": {"type": "string"}},
        "required_singleton_ids": {"type": "array", "minItems": 38, "maxItems": 38, "uniqueItems": true, "items": {"type": "string"}},
        "expected_counts": {"type": "object", "minProperties": 9, "additionalProperties": {"type": "integer", "minimum": 1}}
      }, "additionalProperties": false
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scenario", "plugin", "client", "level", "outcome", "tuple", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
          "scenario": {"type": "string", "minLength": 1},
          "plugin": {"type": ["string", "null"]},
          "client": {"type": ["string", "null"]},
          "level": {"enum": ["schema", "materialization", "discovery", "runtime", "oauth", "harness"]},
          "outcome": {"enum": ["passed", "failed", "inconclusive", "not_applicable"]},
          "tuple": {"$ref": "#/$defs/tuple"},
          "reason": {"type": "string", "minLength": 1},
          "details": {
            "type": "object",
            "propertyNames": {"not": {"const": "ref"}},
            "properties": {
              "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
              "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
              "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"outcome": {"const": "passed"}, "level": {"const": "discovery"}}, "required": ["outcome", "level"]},
            "then": {"properties": {"tuple": {"$ref": "#/$defs/completeTuple"}, "details": {"required": ["evidence_basis", "runtime_proof", "native_discovery_proof", "native_discovery_evidence", "native_identity_state", "copilot_package"], "properties": {"evidence_basis": {"const": "native_client_command"}, "runtime_proof": {"const": false}, "native_discovery_proof": {"const": true}, "native_identity_state": {"const": "managed"}}}}}
          },
          {
            "if": {"properties": {"outcome": {"const": "passed"}, "level": {"enum": ["runtime", "oauth"]}}, "required": ["outcome", "level"]},
            "then": {
              "properties": {"tuple": {"$ref": "#/$defs/completeTuple"}, "details": {"required": ["evidence_basis", "native_discovery_proof"], "properties": {"evidence_basis": {"const": "protected_external_observer"}}}},
              "allOf": [
                {
                  "if": {"properties": {"client": {"const": "chatgpt"}}, "required": ["client"]},
                  "then": {"properties": {"scenario": {"const": "chatgpt_registered_binding"}, "plugin": {"const": "cloudflare-docs"}, "details": {"required": ["public_mcp_proof", "public_mcp_evidence"], "properties": {"native_discovery_proof": {"const": false}, "public_mcp_proof": {"const": true}}, "not": {"required": ["native_discovery_evidence"]}}}},
                  "else": {"properties": {"details": {"required": ["native_discovery_evidence"], "properties": {"native_discovery_proof": {"const": true}}}}}
                }
              ]
            }
          },
          {
            "if": {"properties": {"outcome": {"const": "passed"}, "level": {"enum": ["schema", "materialization"]}}, "required": ["outcome", "level"]},
            "then": {"properties": {"tuple": {"$ref": "#/$defs/repositoryProofTuple"}, "details": {"required": ["evidence_basis", "runtime_proof", "native_discovery_proof"], "properties": {"evidence_basis": {"const": "repository_owned_disposable_observer"}, "runtime_proof": {"const": false}, "native_discovery_proof": {"const": false}}}}}
          }
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["passed", "failed", "inconclusive", "not_applicable", "required_gates_complete", "hero_runtime_results"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "inconclusive": {"type": "integer", "minimum": 0},
        "not_applicable": {"type": "integer", "minimum": 0},
        "required_gates_complete": {"type": "boolean"},
        "hero_runtime_results": {"type": "integer", "minimum": 0, "maximum": 15}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["redacted_export", "consent_artifact_digest", "pseudonymous_identity_id", "pseudonymous_workspace_id", "dedicated_identity", "disposable_project_status", "operation_mode", "auth_origin", "cleanup_outcome", "contains_absolute_home_paths", "contains_credentials", "real_user_project_used", "auth_copied"],
      "properties": {
        "redacted_export": {"const": true},
        "consent_artifact_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pseudonymous_identity_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
        "pseudonymous_workspace_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
        "dedicated_identity": {"const": true},
        "disposable_project_status": {"enum": ["disposed", "not-created"]},
        "operation_mode": {"enum": ["read-only", "synthetic"]},
        "auth_origin": {"enum": ["fresh-dedicated-identity", "none"]},
        "cleanup_outcome": {"enum": ["cleaned", "not-created"]},
        "contains_absolute_home_paths": {"const": false},
        "contains_credentials": {"const": false},
        "real_user_project_used": {"const": false},
        "auth_copied": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "tuple": {
      "type": "object",
      "required": ["product_id", "tree_digest", "manifest_digest", "distribution_id", "distribution_kind", "release_sequence", "package_version", "source_repository", "source_revision", "source_path", "snapshot_sequence", "snapshot_digest", "binary_digest", "dependency_identity", "installer_version", "adapter_version", "client_version", "os", "architecture", "observed_at"],
      "properties": {
        "product_id": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "tree_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "manifest_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "distribution_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"},
        "distribution_kind": {"type": ["string", "null"], "enum": ["upstream", "community_bridge", "community", "direct", null]},
        "release_sequence": {"type": ["integer", "null"], "minimum": 1},
        "package_version": {"type": ["string", "null"], "minLength": 1},
        "source_repository": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,99})$"},
        "source_revision": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
        "source_path": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[?#%])[^\\u0000]+(?<!/)$"},
        "snapshot_sequence": {"type": ["integer", "null"], "minimum": 1},
        "snapshot_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "binary_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "dependency_identity": {"type": ["string", "null"]},
        "installer_version": {"type": ["string", "null"]},
        "adapter_version": {"type": ["string", "null"]},
        "client_version": {"type": ["string", "null"]},
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "repositoryProofTuple": {
      "allOf": [
        {"$ref": "#/$defs/tuple"},
        {"properties": {
          "product_id": {"type": "string"}, "tree_digest": {"type": "string"}, "manifest_digest": {"type": "string"},
          "distribution_id": {"type": "string"}, "distribution_kind": {"type": "string"},
          "release_sequence": {"type": "integer"}, "package_version": {"type": "string"},
          "snapshot_sequence": {"type": "integer"}, "snapshot_digest": {"type": "string"},
          "binary_digest": {"type": "string"}, "dependency_identity": {"type": "string", "minLength": 1},
          "installer_version": {"type": "string", "minLength": 1}, "adapter_version": {"type": "string", "minLength": 1},
          "client_version": {"const": null}
        }}
      ]
    },
    "completeTuple": {
      "allOf": [
        {"$ref": "#/$defs/tuple"},
        {"properties": {
          "product_id": {"type": "string"}, "tree_digest": {"type": "string"}, "manifest_digest": {"type": "string"},
          "distribution_id": {"type": "string"}, "distribution_kind": {"type": "string"},
          "release_sequence": {"type": "integer"}, "package_version": {"type": "string"},
          "source_repository": {"type": "string"}, "source_revision": {"type": "string"},
          "source_path": {"type": "string"},
          "snapshot_sequence": {"type": "integer"}, "snapshot_digest": {"type": "string"},
          "binary_digest": {"type": "string"}, "dependency_identity": {"type": "string", "minLength": 1},
          "installer_version": {"type": "string", "minLength": 1}, "adapter_version": {"type": "string", "minLength": 1},
          "client_version": {"type": "string", "minLength": 1}
        }}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"run": {"properties": {"mode": {"const": "enforced"}}}}}, "then": {"properties": {
      "summary": {"properties": {"hero_runtime_results": {"const": 15}}},
      "release": {"properties": {"repository": {"type": "string"}, "tag": {"type": "string"}, "tag_commit": {"type": "string"}, "release_id": {"type": "integer"}, "immutable": {"const": true}, "manifest_digest": {"type": "string"}, "checksums_digest": {"type": "string"}}},
      "directory": {"properties": {"origin": {"type": "string"}, "snapshot_digest": {"type": "string"}, "sequence": {"type": "integer"}, "trust_root_digest": {"type": "string"}}}
    }}},
    {"not": {"properties": {"matrix": {"contains": {"type": "object", "properties": {"client": {"const": "chatgpt"}, "plugin": {"not": {"const": "cloudflare-docs"}}}, "required": ["client", "plugin"]}}}, "required": ["matrix"]}}
  ],
  "additionalProperties": false
}
