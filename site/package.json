{
  "name": "universal-agent-plugins-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "ignoredOptionalDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "nuxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "nuxt": "3.21.8",
    "vue": "3.5.34",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.15.2",
    "eslint": "9.39.4",
    "typescript": "5.9.3"
  }
}
