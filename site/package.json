{
  "name": "universal-agent-plugins-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
      "brace-expansion@>=4.0.0 <6.0.0": "5.0.9",
      "esbuild@>=0.27.3 <0.28.1": "0.28.2",
      "immutable@>=5.0.0-beta.1 <5.1.8": "5.1.9",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "shell-quote@<=1.8.4": "1.10.0",
      "svgo@>=4.0.0 <4.0.2": "4.0.2",
      "tar@<=7.5.20": "7.5.22"
    },
    "ignoredOptionalDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "lint": "nuxt prepare && eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "nuxt prepare && vue-tsc --noEmit",
    "check:generated": "node scripts/check-generated.mjs"
  },
  "dependencies": {
    "nuxt": "3.21.11",
    "vue": "3.5.41",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.15.2",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.9"
  }
}
