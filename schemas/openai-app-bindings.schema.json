{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/777genius/universal-agent-plugins/schemas/openai-app-bindings.schema.json",
  "title": "Host-only ChatGPT development app bindings",
  "type": "object",
  "required": ["$schema", "schema_version", "bindings"],
  "properties": {
    "$schema": { "const": "../../schemas/openai-app-bindings.schema.json" },
    "schema_version": { "const": 1 },
    "bindings": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["app_key", "id", "mcp_server", "mcp_url", "runtime_evidence", "runtime_evidence_revision", "runtime_evidence_digest", "personal_app_evidence", "personal_app_evidence_revision", "personal_app_evidence_digest", "registration"],
        "properties": {
          "app_key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._~:-]{0,255}$"
          },
          "mcp_server": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "mcp_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/?#@\\s]+(?:/[^?#]*)?$"
          },
          "runtime_evidence": {
            "type": "string",
            "pattern": "^tests/e2e/results/[a-z0-9-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.json$"
          },
          "runtime_evidence_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "runtime_evidence_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "personal_app_evidence": {
            "type": "string",
            "pattern": "^tests/e2e/results/[a-z0-9-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.json$"
          },
          "personal_app_evidence_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "personal_app_evidence_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "registration": {
            "type": "object",
            "required": ["surface", "status", "authentication"],
            "properties": {
              "surface": { "const": "chatgpt_developer_mode" },
              "status": { "const": "development" },
              "authentication": { "const": "none" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
