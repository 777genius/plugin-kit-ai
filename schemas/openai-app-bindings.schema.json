{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/777genius/universal-agent-plugins/schemas/openai-app-bindings.schema.json",
  "title": "Host-only ChatGPT development app bindings",
  "type": "object",
  "required": ["$schema", "schema_version", "bindings"],
  "properties": {
    "$schema": { "const": "../../schemas/openai-app-bindings.schema.json" },
    "schema_version": { "const": 1 },
    "bindings": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["app_key", "id", "mcp_server", "mcp_url", "runtime_evidence", "registration"],
        "properties": {
          "app_key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "id": { "type": "string", "pattern": "^plugin_asdk_app_[A-Za-z0-9]+$" },
          "mcp_server": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "mcp_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "runtime_evidence": {
            "type": "string",
            "pattern": "^tests/e2e/results/[a-z0-9-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.json$"
          },
          "registration": {
            "type": "object",
            "required": ["surface", "status", "authentication"],
            "properties": {
              "surface": { "const": "chatgpt_developer_mode" },
              "status": { "const": "development" },
              "authentication": { "const": "none" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
