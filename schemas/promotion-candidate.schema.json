{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/promotion-candidate.schema.json",
  "title": "Read-only upstream promotion readiness candidate",
  "type": "object",
  "required": ["schema_version", "decision", "product", "distribution", "release", "policy", "source", "evidence", "gate_artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "decision": {"const": "reviewable_promotion_candidate"},
    "product": {
      "type": "object",
      "required": ["id", "manifest_name"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "manifest_name": {"$ref": "#/$defs/id"}},
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {"id": {"$ref": "#/$defs/distribution"}, "kind": {"const": "upstream"}},
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["sequence", "package_version", "agent_plugins_schema", "components", "tree_digest_algorithm", "tree_digest", "manifest_digest"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "package_version": {"type": "string"},
        "agent_plugins_schema": {"const": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"},
        "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["extensions", "mcp", "skills"]}},
        "tree_digest_algorithm": {"const": "agentplugins-tree-sha256-v1"},
        "tree_digest": {"$ref": "#/$defs/digest"},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["status", "minimum_installer_version", "targets"],
      "properties": {
        "status": {"const": "active"},
        "minimum_installer_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "targets": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/target"}}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["repository", "path", "upstream_pr_number", "upstream_pr_url", "merged_at", "reviewed_pr_head_sha", "official_candidate_sha", "official_default_ref", "official_default_tip_sha", "byte_classification"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"}, "path": {"$ref": "#/$defs/path"},
        "upstream_pr_number": {"type": "integer", "minimum": 1},
        "upstream_pr_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*/pull/[1-9][0-9]*$"},
        "merged_at": {"type": "string", "format": "date-time"},
        "reviewed_pr_head_sha": {"$ref": "#/$defs/sha"}, "official_candidate_sha": {"$ref": "#/$defs/sha"},
        "official_default_ref": {"type": "string", "pattern": "^refs/remotes/origin/[^ ]+$"},
        "official_default_tip_sha": {"$ref": "#/$defs/sha"}, "byte_classification": {"const": "exact"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object", "required": ["id", "record_digest", "level", "client", "installer_version", "artifact"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"}, "record_digest": {"$ref": "#/$defs/digest"},
          "level": {"enum": ["schema", "materialization", "discovery", "runtime", "oauth"]},
          "client": {"type": ["string", "null"]}, "installer_version": {"type": ["string", "null"]},
          "artifact": {"$ref": "#/$defs/artifact"}
        }, "additionalProperties": false
      }
    },
    "gate_artifacts": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {"type": "object", "required": ["name", "artifact_digest"], "properties": {"name": {"type": "string"}, "artifact_digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "distribution": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
    "evidencePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "required": ["repository", "revision", "path", "digest"],
      "properties": {"repository": {"$ref": "#/$defs/repository"}, "revision": {"$ref": "#/$defs/sha"}, "path": {"$ref": "#/$defs/evidencePath"}, "digest": {"$ref": "#/$defs/digest"}},
      "additionalProperties": false
    },
    "target": {
      "type": "object", "required": ["client", "scopes", "delivery", "authentication"],
      "properties": {
"client": {"enum": ["codex", "chatgpt", "cursor", "copilot", "vscode", "kiro", "claude", "gemini", "opencode", "cline", "windsurf"]}, "scopes": {"const": ["user"]},
        "delivery": {"enum": ["managed", "prepared", "manual_activation"]}, "authentication": {"enum": ["not_required", "required", "unknown"]},
        "app_binding": {
          "type": "object", "required": ["app_key", "id", "mcp_server"],
          "properties": {"app_key": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}, "mcp_server": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        }
      }, "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"client": {"const": "chatgpt"}}, "required": ["client"]}, "then": {"required": ["app_binding"]}, "else": {"not": {"required": ["app_binding"]}}}
      ]
    }
  },
  "additionalProperties": false
}
