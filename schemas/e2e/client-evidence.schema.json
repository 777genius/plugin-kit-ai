{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/777genius/universal-agent-plugins/schemas/e2e/client-evidence.schema.json",
  "title": "Sanitized client E2E evidence",
  "type": "object",
  "required": [
    "client",
    "date",
    "checks",
    "secrets_recorded",
    "real_user_project_used",
    "privacy"
  ],
  "properties": {
    "client": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "date_timezone": { "const": "Europe/Kyiv" },
    "observed_at_utc": { "type": "string", "format": "date-time" },
    "evidence_type": { "type": "string", "minLength": 1 },
    "product_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "distribution_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
    "distribution_kind": { "enum": ["upstream", "community_bridge", "community", "direct"] },
    "release_sequence": { "type": "integer", "minimum": 1 },
    "package_version": { "type": "string", "minLength": 1 },
    "tree_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "snapshot_sequence": { "type": "integer", "minimum": 1 },
    "snapshot_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "installer_version": { "type": "string", "pattern": "^(?:0\\.1\\.(?:[89]|[1-9][0-9]+)|0\\.(?:[2-9]|[1-9][0-9]+)\\.[0-9]+|[1-9][0-9]*\\.[0-9]+\\.[0-9]+)$" },
    "adapter_version": { "type": "string", "minLength": 1 },
    "binary_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "immutable_source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "consent_artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "result_root_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "outcome": { "enum": ["passed", "failed", "inconclusive", "not_applicable"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario", "status"],
        "properties": {
          "scenario": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["passed", "auth_required", "manual_step", "failed", "skipped"]
          }
        },
        "additionalProperties": true
      }
    },
    "secrets_recorded": { "const": false },
    "real_user_project_used": { "type": "boolean" },
    "binding": {
      "type": "object",
      "required": ["plugin", "app_id", "mcp_url"],
      "properties": {
        "plugin": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "app_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~:-]{0,255}$"
        },
        "mcp_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@\\s]+(?:/[^?#]*)?$"
        }
      },
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "required": ["revision", "digest"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "required": ["directory_source", "display_name", "installation_state", "detail_action", "opened_mode", "plugin_chip_selected", "activation_evidence"],
      "properties": {
        "directory_source": { "const": "Personal" },
        "display_name": { "const": "Universal Agent Plugins Cloudflare Docs E2E" },
        "installation_state": { "const": "Installed" },
        "detail_action": { "const": "Попробовать в чате" },
        "opened_mode": { "const": "Chat" },
        "plugin_chip_selected": { "const": true },
        "activation_evidence": { "const": "user_attested_manual" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["prompt_count", "tool_call_count", "read_only"],
      "properties": {
        "prompt_count": { "const": 1 },
        "tool_call_count": { "const": 2 },
        "read_only": { "const": true }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["proved", "not_proved"],
      "properties": {
        "proved": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "not_proved": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["sanitized", "excluded"],
      "properties": {
        "sanitized": { "const": true },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidence_type": { "const": "stable_launch_client_v2" } },
        "required": ["evidence_type"]
      },
      "then": {
        "required": [
          "product_id", "distribution_id", "distribution_kind", "release_sequence", "package_version", "tree_digest",
          "manifest_digest", "snapshot_sequence", "snapshot_digest",
          "installer_version", "adapter_version", "binary_digest",
          "immutable_source_revision", "consent_artifact_digest",
          "result_root_id", "outcome", "observed_at_utc"
        ],
        "allOf": [
          {
            "if": { "properties": { "client": { "pattern": "^ChatGPT" } } },
            "then": { "properties": { "product_id": { "const": "cloudflare-docs" } } }
          }
        ],
        "not": { "anyOf": [{"required": ["ref"]}, {"required": ["revision"]}] }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_type": { "const": "interactive_personal_app_runtime" }
        },
        "required": ["evidence_type"]
      },
      "then": {
        "required": ["version", "date_timezone", "binding", "catalog", "source", "ui", "runtime", "scope", "cleanup"],
        "properties": {
          "client": { "const": "ChatGPT web Plugins UI" },
          "checks": {
            "items": { "required": ["scenario", "operation", "status"] }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "client": { "const": "ChatGPT Developer Mode" },
          "evidence_type": { "const": "interactive_direct_mcp_runtime" }
        },
        "required": ["client", "evidence_type"]
      },
      "then": {
        "required": ["version", "date_timezone", "binding", "source", "cleanup"],
        "properties": {
          "checks": {
            "items": { "required": ["scenario", "operation", "status"] }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "client": { "const": "ChatGPT web" } },
        "required": ["client"]
      },
      "then": {
        "required": [
          "version",
          "observed_at_utc",
          "account_context",
          "workspace_context",
          "preconditions",
          "observed_redirect_origin",
          "cleanup"
        ],
        "properties": {
          "account_context": {
            "enum": ["dedicated_test", "user_approved_personal", "unknown"]
          },
          "workspace_context": {
            "enum": ["dedicated_test", "user_approved_personal", "unknown"]
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "observed_redirect_origin": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "cleanup": {
            "type": "object",
            "required": ["status", "connection_removed", "developer_mode_restored"],
            "properties": {
              "status": { "enum": ["pending", "partial", "completed", "retained_with_user_approval"] },
              "connection_removed": { "type": ["boolean", "null"] },
              "developer_mode_restored": { "type": ["boolean", "null"] },
              "provider_grant_revoked": { "type": ["boolean", "null"] },
              "provider_revocation_method": { "type": ["string", "null"], "minLength": 1 },
              "provider_revocation_observation": { "type": ["string", "null"], "minLength": 1 },
              "last_checked_at_utc": { "type": "string", "format": "date-time" },
              "completed_at_utc": { "type": "string", "format": "date-time" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "status": { "const": "completed" } },
                  "required": ["status"]
                },
                "then": {
                  "required": [
                    "completed_at_utc",
                    "connection_removed",
                    "developer_mode_restored",
                    "provider_grant_revoked",
                    "provider_revocation_method"
                  ],
                  "properties": {
                    "connection_removed": { "const": true },
                    "developer_mode_restored": { "const": true },
                    "provider_grant_revoked": { "const": true }
                  }
                }
              },
              {
                "if": {
                  "properties": { "status": { "const": "partial" } },
                  "required": ["status"]
                },
                "then": {
                  "required": [
                    "provider_grant_revoked",
                    "provider_revocation_observation",
                    "last_checked_at_utc"
                  ],
                  "not": {
                    "required": [
                      "connection_removed",
                      "developer_mode_restored",
                      "provider_grant_revoked"
                    ],
                    "properties": {
                      "connection_removed": { "const": true },
                      "developer_mode_restored": { "const": true },
                      "provider_grant_revoked": { "const": true }
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "client": { "const": "ChatGPT desktop app (Codex backend)" },
          "evidence_type": { "const": "desktop_package_ingestion_control_plane" }
        },
        "required": ["client", "evidence_type"]
      },
      "then": {
        "required": [
          "version",
          "date_timezone",
          "observed_at_utc",
          "binding",
          "source",
          "manager",
          "backend",
          "scope",
          "cleanup",
          "screenshots_committed"
        ],
        "properties": {
          "real_user_project_used": { "const": false },
          "screenshots_committed": { "const": false },
          "binding": {
            "properties": {
              "plugin": { "const": "cloudflare-docs" },
              "app_id": {
                "const": "plugin_asdk_app_6a78e90cf73481918ef10cdb87cd4bb4"
              },
              "mcp_url": { "const": "https://docs.mcp.cloudflare.com/mcp" }
            }
          },
          "source": {
            "type": "object",
            "required": [
              "repository",
              "marketplace",
              "marketplace_revision",
              "plugin",
              "plugin_version",
              "plugin_path"
            ],
            "properties": {
              "repository": {
                "const": "https://github.com/777genius/universal-agent-plugins"
              },
              "marketplace": { "const": "universal-agent-plugins" },
              "marketplace_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "plugin": { "const": "cloudflare-docs" },
              "plugin_version": { "const": "0.1.0" },
              "plugin_path": {
                "const": "compat/openai/plugins/cloudflare-docs"
              }
            },
            "additionalProperties": false
          },
          "manager": {
            "type": "object",
            "required": [
              "marketplace_registered",
              "package_installed",
              "package_enabled",
              "cache_materialized",
              "package_shape"
            ],
            "properties": {
              "marketplace_registered": { "const": true },
              "package_installed": { "const": true },
              "package_enabled": { "const": true },
              "cache_materialized": { "const": true },
              "package_shape": { "const": "official_codex_plugin" }
            },
            "additionalProperties": false
          },
          "backend": {
            "type": "object",
            "required": [
              "plugin_read",
              "app_binding_read",
              "app_runtime_snapshot"
            ],
            "properties": {
              "plugin_read": { "const": true },
              "app_binding_read": {
                "const": "plugin_asdk_app_6a78e90cf73481918ef10cdb87cd4bb4"
              },
              "app_runtime_snapshot": {
                "const": "binding_absent_on_codex_backend"
              }
            },
            "additionalProperties": false
          },
          "checks": {
            "items": { "required": ["scenario", "operation", "status"] }
          },
          "cleanup": {
            "type": "object",
            "required": [
              "package_status",
              "marketplace_status",
              "connection_status"
            ],
            "properties": {
              "package_status": {
                "const": "retained_for_follow_up_ui_e2e"
              },
              "marketplace_status": {
                "const": "retained_for_follow_up_ui_e2e"
              },
              "connection_status": {
                "const": "retained_for_follow_up_ui_e2e"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "client": { "const": "Codex CLI" },
          "evidence_type": { "const": "automated_public_install" }
        },
        "required": ["client", "evidence_type"]
      },
      "then": {
        "required": [
          "version",
          "observed_at_utc",
          "sandbox",
          "source",
          "workflow",
          "reproduction",
          "transcript"
        ],
        "properties": {
          "source": {
            "type": "object",
            "required": ["repository", "ref", "commit_sha"],
            "properties": {
              "repository": {
                "const": "https://github.com/777genius/universal-agent-plugins"
              },
              "ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
              },
              "commit_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "additionalProperties": false
          },
          "workflow": {
            "type": "object",
            "required": ["url", "commit_sha", "event"],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://github\\.com/777genius/universal-agent-plugins/actions/runs/[0-9]+$"
              },
              "commit_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "event": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "reproduction": {
            "type": "object",
            "required": ["requirements", "commands"],
            "properties": {
              "requirements": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "commands": {
                "type": "array",
                "minItems": 3,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          },
          "transcript": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "string", "minLength": 1 }
          },
          "real_user_project_used": { "const": false }
        }
      }
    }
  ],
  "additionalProperties": true
}
