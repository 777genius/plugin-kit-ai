{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/registry-index.schema.json",
  "title": "Universal Agent Plugins public registry index",
  "type": "object",
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "plugins": {
      "type": "array",
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "required": ["repository", "revision", "path", "manifest_sha256", "tree_sha256"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "tree_sha256": {"$ref": "#/$defs/digest"},
        "icon_sha256": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["level", "schema", "runtime_evidence"],
      "properties": {
        "level": {"enum": ["schema_only", "runtime_evidence"]},
        "schema": {"const": "agent-plugins-1.0"},
        "runtime_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"level": {"const": "schema_only"}}},
          "then": {"properties": {"runtime_evidence": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"level": {"const": "runtime_evidence"}}},
          "then": {"properties": {"runtime_evidence": {"minItems": 1}}}
        }
      ]
    },
    "clientSupport": {
      "type": "object",
      "required": ["resolution", "clients"],
      "properties": {
        "resolution": {"enum": ["catalog", "install_time"]},
        "clients": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
"items": {"enum": ["codex", "chatgpt", "cursor", "copilot", "vscode", "kiro", "claude", "gemini", "opencode", "cline", "windsurf"]}
        }
      },
      "additionalProperties": false
    },
    "icon": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^assets/plugin-icons/[a-zA-Z0-9._-]+$"},
        "sha256": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "plugin": {
      "type": "object",
      "required": ["name", "version", "description", "author", "license", "categories", "keywords", "source", "install_source", "built_in", "client_support", "validation", "components"],
      "properties": {
        "name": {"type": "string", "pattern": "^(?!.*(?:--|\\.\\.))[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
        "version": {"type": "string"},
        "description": {"type": "string", "minLength": 1},
        "author": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "email": {"type": "string"},
            "url": {"type": "string"}
          },
          "additionalProperties": false
        },
        "license": {"type": "string", "minLength": 1},
        "categories": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
        "keywords": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source": {"$ref": "#/$defs/source"},
        "install_source": {"type": "string", "minLength": 1},
        "built_in": {"type": "boolean"},
        "client_support": {"$ref": "#/$defs/clientSupport"},
        "validation": {"$ref": "#/$defs/validation"},
        "components": {"type": "array", "items": {"enum": ["extensions", "mcp", "skills"]}, "uniqueItems": true},
        "icon": {"$ref": "#/$defs/icon"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"built_in": {"const": true}}},
          "then": {"properties": {"client_support": {"properties": {"resolution": {"const": "catalog"}}}}}
        },
        {
          "if": {"properties": {"built_in": {"const": false}}},
          "then": {
            "properties": {
              "install_source": {"pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9._-]*@[0-9a-f]{40}//.+$"},
              "client_support": {"properties": {"resolution": {"const": "install_time"}}}
            },
            "not": {"required": ["icon"]}
          }
        }
      ]
    }
  }
}
