{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/directory-snapshot.schema.json",
  "title": "Universal Agent Plugins Directory signed snapshot",
  "type": "object",
  "required": ["snapshot_schema_version", "sequence", "publication_id", "source_commit", "generated_at", "expires_at", "products", "distributions", "evidence", "revocations"],
  "properties": {
    "snapshot_schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "publication_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "products": {"type": "array", "items": {"$ref": "directory-publication-candidate.schema.json#/$defs/product"}},
    "distributions": {"type": "array", "items": {"$ref": "#/$defs/distribution"}},
    "evidence": {"type": "array", "items": {"oneOf": [
      {"$ref": "directory-publication-candidate.schema.json#/$defs/evidence"},
      {"$ref": "directory-evidence.schema.json"}
    ]}},
    "revocations": {"type": "array", "items": {"$ref": "directory-publication-candidate.schema.json#/$defs/revocation"}}
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "release": {
      "allOf": [
        {"$ref": "directory-publication-candidate.schema.json#/$defs/release"},
        {"type": "object", "properties": {"published_at": {"$ref": "#/$defs/timestamp"}}}
      ]
    },
    "distribution": {
      "type": "object",
      "required": ["schema_version", "id", "product_id", "kind", "status", "packager", "releases", "release_policies"],
      "properties": {
        "schema_version": {"const": 1},
        "id": {"$ref": "directory-publication-candidate.schema.json#/$defs/distributionId"},
        "product_id": {"$ref": "directory-publication-candidate.schema.json#/$defs/id"},
        "kind": {"enum": ["upstream", "community_bridge", "community"]},
        "status": {"enum": ["active", "suspended"]},
        "packager": {"$ref": "directory-publication-candidate.schema.json#/$defs/id"},
        "releases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/release"}},
        "release_policies": {"type": "array", "minItems": 1, "items": {"$ref": "directory-publication-candidate.schema.json#/$defs/policy"}}
      },
      "additionalProperties": false
    }
  }
}
