{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/directory-publication-candidate.schema.json",
  "title": "Canonical no-secret Directory publication candidate",
  "type": "object",
  "required": ["candidate_schema_version", "snapshot_schema_version", "publication_id", "source_commit", "lifetime_days", "products", "distributions", "evidence", "revocations"],
  "properties": {
    "candidate_schema_version": {"const": 1},
    "snapshot_schema_version": {"const": 1},
    "publication_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source_commit": {"$ref": "#/$defs/sha"},
    "lifetime_days": {"type": "integer", "minimum": 1, "maximum": 30},
    "products": {"type": "array", "items": {"$ref": "#/$defs/product"}},
    "distributions": {"type": "array", "items": {"$ref": "#/$defs/distribution"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "revocations": {"type": "array", "items": {"$ref": "#/$defs/revocation"}}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "evidenceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
    "distributionId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "source": {
      "type": "object",
      "required": ["repository", "revision", "path"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "revision": {"$ref": "#/$defs/sha"},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["client", "scopes", "delivery", "authentication"],
      "properties": {
        "client": {"enum": ["codex", "chatgpt", "cursor", "copilot", "vscode", "kiro"]},
        "scopes": {"const": ["user"]},
        "delivery": {"enum": ["managed", "prepared", "manual_activation"]},
        "authentication": {"enum": ["not_required", "required", "unknown"]},
        "app_binding": {
          "type": "object",
          "required": ["app_key", "id", "mcp_server"],
          "properties": {"app_key": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}, "mcp_server": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [{"if": {"properties": {"client": {"const": "chatgpt"}}, "required": ["client"]}, "then": {"required": ["app_binding"]}, "else": {"not": {"required": ["app_binding"]}}}]
    },
    "policy": {
      "type": "object",
      "required": ["release_sequence", "status", "minimum_installer_version", "targets", "current_evidence"],
      "properties": {
        "release_sequence": {"type": "integer", "minimum": 1},
        "status": {"enum": ["active", "superseded", "revoked"]},
        "minimum_installer_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
        "current_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}}
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["sequence", "package_version", "manifest_name", "agent_plugins_schema", "package_source", "tree_digest_algorithm", "tree_digest", "manifest_digest", "components", "published_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "package_version": {"type": "string"},
        "manifest_name": {"$ref": "#/$defs/id"},
        "agent_plugins_schema": {"const": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"},
        "package_source": {"$ref": "#/$defs/source"},
        "tree_digest_algorithm": {"const": "agentplugins-tree-sha256-v1"},
        "build_provenance": {
          "type": "object",
          "required": ["upstream_repository", "upstream_revision"],
          "properties": {"upstream_repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"}, "upstream_revision": {"$ref": "#/$defs/sha"}},
          "additionalProperties": false
        },
        "tree_digest": {"$ref": "#/$defs/digest"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["extensions", "mcp", "skills"]}},
        "published_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": ["schema_version", "id", "product_id", "kind", "status", "packager", "releases", "release_policies"],
      "properties": {
        "schema_version": {"const": 1}, "id": {"$ref": "#/$defs/distributionId"}, "product_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["upstream", "community_bridge", "community"]}, "status": {"enum": ["active", "suspended"]}, "packager": {"$ref": "#/$defs/id"},
        "releases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/release"}},
        "release_policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/policy"}}
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": ["schema_version", "id", "display_name", "description", "manifest_name", "aliases", "reserved_aliases", "categories", "minimum_capabilities", "default_distribution", "distributions"],
      "properties": {
        "schema_version": {"const": 1}, "id": {"$ref": "#/$defs/id"}, "display_name": {"type": "string", "minLength": 1, "maxLength": 100}, "description": {"type": "string", "minLength": 1, "maxLength": 500}, "manifest_name": {"$ref": "#/$defs/id"},
        "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "reserved_aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "categories": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "icon": {"type": "object", "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^assets/plugin-icons/[A-Za-z0-9._-]+$"}, "digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false},
        "minimum_capabilities": {"type": "object", "required": ["skills", "mcp"], "properties": {"skills": {"enum": ["required", "optional"]}, "mcp": {"enum": ["required", "optional"]}}, "additionalProperties": false, "not": {"properties": {"skills": {"const": "optional"}, "mcp": {"const": "optional"}}, "required": ["skills", "mcp"]}},
        "default_distribution": {"$ref": "#/$defs/distributionId"}, "distributions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/distributionId"}}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["schema_version", "id", "product_id", "distribution_id", "release_sequence", "package_tree_digest", "manifest_digest", "source_repository", "source_revision", "source_path", "level", "outcome", "artifact"],
      "properties": {
        "schema_version": {"const": 1}, "id": {"$ref": "#/$defs/evidenceId"}, "product_id": {"$ref": "#/$defs/id"}, "distribution_id": {"$ref": "#/$defs/distributionId"}, "release_sequence": {"type": "integer", "minimum": 1}, "package_tree_digest": {"$ref": "#/$defs/digest"}, "manifest_digest": {"$ref": "#/$defs/digest"},
        "source_repository": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,99})$"}, "source_revision": {"$ref": "#/$defs/sha"}, "source_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[?#%])[^\\u0000]+(?<!/)$"},
        "level": {"enum": ["schema", "materialization", "discovery", "runtime", "oauth"]}, "outcome": {"enum": ["passed", "failed", "inconclusive", "not_tested", "not_applicable"]},
        "client": {"enum": ["codex", "chatgpt", "cursor", "copilot", "vscode", "kiro"]}, "client_version": {"type": "string", "minLength": 1}, "installer_version": {"type": "string", "minLength": 1}, "adapter_version": {"type": "string", "minLength": 1}, "os": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}, "dependency_identity": {"type": "string", "minLength": 1}, "observed_at": {"$ref": "#/$defs/timestamp"},
        "artifact": {"type": "object", "required": ["repository", "revision", "path", "digest"], "properties": {"repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"}, "revision": {"$ref": "#/$defs/sha"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"}, "digest": {"$ref": "#/$defs/digest"}}, "additionalProperties": false}
      },
      "additionalProperties": false,
      "allOf": [{"if": {"properties": {"level": {"const": "schema"}}}, "then": {"not": {"required": ["client"]}}}, {"if": {"properties": {"level": {"enum": ["materialization", "discovery", "runtime", "oauth"]}}}, "then": {"required": ["client", "client_version", "installer_version", "os", "architecture", "observed_at"]}}]
    },
    "revocation": {"type": "object", "required": ["distribution_id", "release_sequence"], "properties": {"distribution_id": {"$ref": "#/$defs/distributionId"}, "release_sequence": {"type": "integer", "minimum": 1}}, "additionalProperties": false}
  }
}
